<UserControl x:Class="CacheCleanup.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CacheCleanup.Localization"
             Focusable="True">

    <Grid x:Name="Root" Background="{DynamicResource Brush.Overlay}" MouseLeftButtonDown="OnBackgroundClick">
        <Border x:Name="Card" Width="500" Padding="32,30" CornerRadius="22" Background="{DynamicResource Brush.CardSolid}"
                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="OnCardClick">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" />
                    <TranslateTransform x:Name="CardT" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="14" Opacity="0.5" Color="Black" />
            </Border.Effect>

            <StackPanel>
                <Border x:Name="IconTile" Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock x:Name="IconGlyph" Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="22" Margin="0,18,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="{loc:Str common.cancel}" Click="OnCancel" MinWidth="110" Padding="18,11" />
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="OnOk" MinWidth="130" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
