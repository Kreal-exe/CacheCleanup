<UserControl x:Class="CacheCleanup.Views.TargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CacheCleanup.Controls"
             xmlns:loc="clr-namespace:CacheCleanup.Localization"
             xmlns:vm="clr-namespace:CacheCleanup.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Margin="32,6,32,14" c:Entrance.Delay="0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str targets.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding TargetsSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" Width="320" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Tag="{loc:Str targets.search}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.all}" Command="{Binding SetFilterCommand}" CommandParameter="All"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=All, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.System}" Command="{Binding SetFilterCommand}" CommandParameter="System"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=System, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.Browsers}" Command="{Binding SetFilterCommand}" CommandParameter="Browsers"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=Browsers, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.Developer}" Command="{Binding SetFilterCommand}" CommandParameter="Developer"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=Developer, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.Apps}" Command="{Binding SetFilterCommand}" CommandParameter="Apps"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=Apps, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.Gaming}" Command="{Binding SetFilterCommand}" CommandParameter="Gaming"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=Gaming, Mode=OneWay}" />
                    <RadioButton Style="{StaticResource Chip}" Content="{loc:Str cat.Custom}" Command="{Binding SetFilterCommand}" CommandParameter="Custom"
                                 IsChecked="{Binding FilterName, Converter={StaticResource Equals}, ConverterParameter=Custom, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Str dash.select}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str dash.selectSafe}" Command="{Binding SelectSafeCommand}" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str dash.selectAll}" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource SubtleButton}" Content="{loc:Str dash.selectNone}" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,26,0">
            <StackPanel Margin="0,2,0,28">
                <ItemsControl ItemsSource="{Binding TargetsView}" c:Entrance.Stagger="28">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TargetVm}">
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10" CornerRadius="16"
                                    Opacity="{Binding IsPresent, Converter={StaticResource BoolToOpacity}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsPresent}" Margin="0,0,16,0" />

                                        <Border Grid.Column="1" Style="{StaticResource IconTileBounce}" Width="38" Height="38" CornerRadius="11"
                                                Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=Soft}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16"
                                                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Pill}" Margin="10,0,0,0" ToolTip="{Binding RiskHint}"
                                                        Background="{Binding Risk, Converter={StaticResource RiskBrush}, ConverterParameter=Soft}">
                                                    <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Background="{DynamicResource Brush.WarningSoft}"
                                                        Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Str titlebar.adminHint}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7EF;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{DynamicResource Brush.Warning}" />
                                                        <TextBlock Text="{loc:Str targets.admin}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="{DynamicResource Brush.Warning}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding RootsText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" ToolTip="{Binding RootsText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDenied}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" MinWidth="96">
                                            <TextBlock c:Counter.Bytes="{Binding Bytes}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding FileCount, Converter={StaticResource LocFormat}, ConverterParameter=dash.filesCount}"
                                                       Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <Button Grid.Column="5" Content="&#xE70D;" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5"
                                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.RenderTransform>
                                                <RotateTransform />
                                            </Button.RenderTransform>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.3">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.3">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>

                                    <!-- expanded details -->
                                    <c:Collapsible Grid.Row="1" IsOpen="{Binding IsExpanded}">
                                    <StackPanel Margin="68,16,0,4">
                                        <Grid>
                                            <TextBlock Text="{loc:Str targets.topEntries}" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding Roots}" HorizontalAlignment="Right">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel HorizontalAlignment="Right" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SubtleButton}" Padding="8,4" Margin="4,0,0,0" ToolTip="{Binding}"
                                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="12" />
                                                                <TextBlock Text="{loc:Str targets.openFolder}" Margin="6,0,0,0" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding TopEntries}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EntryVm}">
                                                    <Grid Height="30" Margin="0,2">
                                                        <c:SmoothBar Value="{Binding Share}" Fill="{DynamicResource Brush.AccentSoft}" Track="{DynamicResource Brush.Inset}" Height="30" Duration="600" />
                                                        <Grid Margin="10,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Margin="10,0,10,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Files, Converter={StaticResource LocFormat}, ConverterParameter=dash.filesCount}"
                                                                       Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Bytes, Converter={StaticResource Bytes}}" FontSize="12.5" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{loc:Str targets.noEntries}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                                   Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisInverse}}" />
                                    </StackPanel>
                                    </c:Collapsible>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Str targets.notFound}" Style="{StaticResource Muted}" Margin="4,12,0,0"
                           Visibility="{Binding IsTargetsViewEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
